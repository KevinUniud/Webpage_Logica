server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 256k;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Healthcheck del solo container web: non dipende dalla disponibilita
    # del repository/API, che puo essere distribuito separatamente.
    location = /web-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Endpoint di dismissione per browser che hanno ancora la vecchia PWA.
    # Non registra nuovi worker: il bootstrap corrente lo usa solo per rimuovere
    # registrazioni/cache ereditate da release precedenti.
    location = /service-worker.js {
        default_type application/javascript;
        expires off;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # CSS e JavaScript non hanno nomi fingerprintati: il browser deve sempre
    # rivalidarli, altrimenti un nuovo HTML puo essere abbinato ad asset vecchi.
    location ~* \.(?:css|js)$ {
        expires off;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|gif|ico|svg|webp)$ {
        expires 7d;
        try_files $uri =404;
    }

    location /api/revisione {
        client_max_body_size 2m;
        proxy_pass ${REVIEW_UPSTREAM}/upload-json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_pass ${API_UPSTREAM}/api/;
    }

    location /health {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_pass ${API_UPSTREAM}/health;
    }
}
